# NEURAL WEB — environment configuration
# Copy this file to .env and fill in your keys:  cp .env.example .env
# Keys can also be added at runtime:  neural-web providers add --id groq --key …
# (runtime keys go to the OS keyring when available, else SQLite with 0600 perms)

# ---- AI providers (at least one required; nothing is hardcoded) ----
# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter (aggregator; also exposes provider-reported credits/quotas)
OPENROUTER_API_KEY=

# Cerebras — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Together AI — https://api.together.xyz/settings
TOGETHER_API_KEY=

# Any other OpenAI-compatible endpoint (LLaMA.cpp, vLLM, LM Studio, LiteLLM…)
# CUSTOM_BASE_URL=http://localhost:8080/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL_ID=

# ---- Search ----
# Tavily: https://tavily.com (free tier available). If missing, the keyless
# fallback engines (Bing HTML + DuckDuckGo HTML + Wikipedia API) are used.
TAVILY_API_KEY=

# ---- Scraping ----
# Firecrawl (optional). If missing, the local engine (httpx + optional
# Playwright + BeautifulSoup + Trafilatura) is used.
FIRECRAWL_API_KEY=

# ---- Storage ----
DATABASE_URL=sqlite:///./neural_web.db

# ---- Tuning (optional) ----
# SCRAPE_TIMEOUT=30
# SCRAPE_MAX_BYTES=3145728
# MAX_CONCURRENT_SCRAPES=4
# PER_HOST_DELAY=1.5
# USER_AGENT=NeuralWebResearch/1.0 (autonomous research agent; respects robots.txt; contact: you@example.com)
